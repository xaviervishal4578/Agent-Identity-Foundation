# Google Cloud & Vertex AI Configuration
GOOGLE_CLOUD_PROJECT=your-gcp-project-id
GOOGLE_CLOUD_LOCATION=global
GOOGLE_GENAI_USE_VERTEXAI=True
MODEL=gemini-3.5-flash

# Remote GitHub MCP Server Endpoint
GITHUB_MCP_URL=https://api.githubcopilot.com/mcp/

# Agent Identity Auth Manager API-Key Auth Provider Resource URI
# Format: projects/<PROJECT_ID>/locations/<LOCATION>/authProviders/<PROVIDER_NAME>
GITHUB_AUTH_PROVIDER_URI=projects/your-gcp-project-id/locations/us-central1/authProviders/github-mcp-auth-provider

# Google Cloud & Vertex AI Configuration
GOOGLE_CLOUD_PROJECT=your-gcp-project-id
GOOGLE_CLOUD_LOCATION=global
GOOGLE_GENAI_USE_VERTEXAI=True
MODEL=gemini-3.5-flash

# Salesforce My Domain Host (used only to derive the REST API base URL; no secrets)
SALESFORCE_DOMAIN=your-org.my.salesforce.com

# Agent Identity Auth Manager 2-Legged OAuth (2LO) Auth Provider Resource URI
# Format: projects/<PROJECT_ID>/locations/<LOCATION>/authProviders/<PROVIDER_NAME>
SALESFORCE_AUTH_PROVIDER_URI=projects/your-gcp-project-id/locations/us-central1/authProviders/salesforce-2lo-auth-provider
